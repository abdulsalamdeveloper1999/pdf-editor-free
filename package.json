{
  "name": "pdf-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "node --test",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder",
    "smoke": "vite build && electron electron/smoke.cjs"
  },
  "dependencies": {
    "@pdf-lib/standard-fonts": "^1.0.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  },
  "main": "electron/main.cjs",
  "description": "Edit PDF text in place, with find and replace",
  "build": {
    "appId": "com.abdulsalamdeveloper1999.pdf-editor-free",
    "productName": "PDF Editor Free",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "releaseType": "draft"
      }
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abdulsalamdeveloper1999/pdf-editor-free.git"
  }
}
